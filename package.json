{
  "name": "agent-flight-recorder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Record, replay, and debug observable AI agent execution.",
  "repository": {
    "type": "git",
    "url": "https://github.com/swarupecenits/Agent-Flight-Recorder.git"
  },
  "bugs": {
    "url": "https://github.com/swarupecenits/Agent-Flight-Recorder/issues"
  },
  "homepage": "https://github.com/swarupecenits/Agent-Flight-Recorder#readme",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium",
    "browser:install:ci": "playwright install --with-deps chromium",
    "check": "npm run build && npm test",
    "demo": "node examples/capture-custom-agent.mjs",
    "demo:prepare": "node scripts/prepare-demo.mjs",
    "demo:screens": "node scripts/capture-screens.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "lucide-react": "0.468.0",
    "react": "19.3.0",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
