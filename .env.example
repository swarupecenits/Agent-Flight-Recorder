# Copy to .env locally. npm start and npm run demo:live load it.
# Existing shell environment values take precedence. Never commit .env or keys.
# The original recorder and all synthetic Lens examples need no cloud account.
AFR_PORT=4180
AFR_URL=http://127.0.0.1:4180

# Optional alternate workspace. Relative paths resolve from the project directory.
# AFR_DB_PATH=data\another-workspace.sqlite

# Optional browser executable override; otherwise use Playwright's Chromium.
# AFR_BROWSER=C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe

# Browser tests use an isolated in-memory workspace, not your saved recordings.
AFR_E2E_PORT=4398

# Optional live Azure Responses integration. Disabled in a fresh checkout.
AFR_ENABLE_FOUNDRY=0
AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=YOUR-DEPLOYMENT
AZURE_OPENAI_API_KEY=
